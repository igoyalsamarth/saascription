{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "check-types": "tsc --noEmit",
    "test": "bun test src/subscriptions/billing-date.test.ts src/controllers/seller-saas.test.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:schema:local": "wrangler d1 execute saascription --local --file=./db/schema.sql",
    "db:schema:remote": "wrangler d1 execute saascription --remote --file=./db/schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply saascription --local",
    "db:migrate:remote": "wrangler d1 migrations apply saascription --remote"
  },
  "dependencies": {
    "@hono/clerk-auth": "^3.1.1",
    "@clerk/backend": "^3.25.0",
    "hono": "^4.13.13",
    "svix": "^2.8.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "^4.151.1"
  }
}
